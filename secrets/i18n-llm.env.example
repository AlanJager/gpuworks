# Copy to secrets/i18n-llm.env. The real file is ignored by git.
# BASE_URL may be an OpenAI-compatible API root ending in /v1 or the complete
# /chat/completions endpoint. Quote values only when the quotes are literal.
I18N_TRANSLATOR_BASE_URL=
I18N_TRANSLATOR_API_KEY=
I18N_TRANSLATOR_MODEL=

I18N_REVIEWER_BASE_URL=
I18N_REVIEWER_API_KEY=
I18N_REVIEWER_MODEL=
