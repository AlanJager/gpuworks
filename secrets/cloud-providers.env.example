# L4 cloud-GPU test credentials. Copy to cloud-providers.env and fill values.

RUNPOD_API_KEY=
# Optional test tier: COMMUNITY (lower cost) or SECURE (RunPod-owned hardware).
RUNPOD_CLOUD_TYPE=COMMUNITY
# Optional: use a Pod started manually in the RunPod console. When all four
# endpoint fields are present, L4 tests attach through SSH and leave the Pod
# untouched. RUNPOD_PRIVATE_KEY may be a PEM value or a local key-file path.
# RUNPOD_POD_ID=
# RUNPOD_PUBLIC_IP=
# RUNPOD_SSH_PORT=22
# RUNPOD_SSH_USER=root
# RUNPOD_PRIVATE_KEY=
# RunPod auto GPU priority (API IDs): RTX 2000 Ada, L4, PRO 6000 MIG 24GB,
# RTX PRO 4000, RTX A5000, A40, RTX A6000.
# PRO 6000 MIG 24GB API ID: NVIDIA RTX PRO 6000 Blackwell Server Edition MIG 1g.24gb
COMPSHARE_ACCESS_KEY=
COMPSHARE_SECRET_KEY=
COMPSHARE_IMAGE_ID=
# Image of CompShare's container product (instances reached only through
# forwarded TCP ports); VM images do not boot a container. Used by
# l4-compshare-server-dial-node-onboarding-container.
COMPSHARE_CONTAINER_IMAGE_ID=

# Additional cloud providers used by the L4 acceptance suite:
VAST_API_KEY=
# Vast must use the SSH public key already registered in the account. This can
# be a PEM value or a local private-key path; it is intentionally explicit so
# an acceptance run never guesses which key is authorized.
VAST_SSH_PRIVATE_KEY=
VAST_SSH_KEY_PATH=
VAST_MAX_HOURLY_PRICE=1.0
VAST_TEST_IMAGE=vastai/base-image:cuda-12.8.1-auto
AUTODL_TOKEN=
AUTODL_IMAGE_UUID=base-image-l2t43iu6uk
AUTODL_MAX_HOURLY_PRICE=10

# Gitee AI 算力市场（https://ai.gitee.com/docs/openapi/v1），用于按需租用昇腾 NPU 云容器。
GITEE_API_TOKEN=
# 可选：不设置则用 test/l4/partition_gitee_test.go 矩阵里硬编码的 zone/image/model。
# GITEE_ZONE=
# GITEE_IMAGE=
# GITEE_GPU_MODEL=

# Alibaba Cloud ECS (L4 cases; spot first, on-demand fallback). Use a RAM user
# limited to ECS and VPC. Build the golden image with
# `make prepare-aliyun-golden-image`; it prints one ALIYUN_IMAGE_<REGION> line
# per region (custom images are region-scoped). A case only rents in regions
# that have one.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_IMAGE_CN_HANGZHOU=
# ALIYUN_IMAGE_CN_BEIJING=
# ALIYUN_IMAGE_CN_SHENZHEN=
# ALIYUN_IMAGE_CN_GUANGZHOU=
# Optional: narrow leak scans to these regions (default: every region).
# ALIYUN_REGIONS=cn-hangzhou,cn-beijing
# Optional: source CIDR allowed to reach SSH and the agent port (default anywhere).
# ALIYUN_INGRESS_CIDR=
# Optional: take one billing mode out. 1 = on.
# ALIYUN_NO_SPOT=
# ALIYUN_NO_ON_DEMAND=
# Optional overrides of what the golden image carries.
# ALIYUN_TEST_IMAGE=gpustack/runner:cuda12.8-vllm0.17.1
# ALIYUN_PRELOADED_MODEL_PATH=/opt/gpuworks/test-fixtures/models/qwen2-0.5b
