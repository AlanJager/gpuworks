+static void *driver_handle;
+static bool driver_handle_tried;
+
+void *vppu_hggc_driver_symbol(const char *symbol)
+{
+    if (!driver_handle_tried) {
+        driver_handle = dlopen("libhggc.so", RTLD_LAZY | RTLD_LOCAL);
+        if (driver_handle == NULL) {
+            vppu_log(VPPU_LOG_DENY, "cannot load libhggc.so (%s)\n", dlerror());
+        }
+        driver_handle_tried = true;
+    }
+    if (driver_handle == NULL) {
+        return NULL;
+    }
+    return dlsym(driver_handle, symbol);
+}

