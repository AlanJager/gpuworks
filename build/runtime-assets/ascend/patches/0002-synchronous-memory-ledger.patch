+static rtError_t finish_pointer_allocation(rtError_t result, void **pointer, memory_reservation_t *reservation,
+                                           memory_allocation_kind_t kind, rt_hook_enum_t free_hook)
+{
+    if (result != RT_ERROR_NONE) {
+        memory_cancel(reservation);
+        return result;
+    }
+    if (pointer != NULL && memory_commit(reservation, (uintptr_t)*pointer, kind) == ENPU_SUCCESS) {
+        return result;
+    }
+
+    if (pointer == NULL) {
+        memory_cancel(reservation);
+    }
+
+    if (pointer != NULL && *pointer != NULL) {
+        rt_symbol_t free_entry = (rt_symbol_t)rt_library_entry[free_hook].func_ptr;
+        if (free_entry != NULL) {
+            (void)free_entry(*pointer);
+        }
+    }
+    LOG_ERROR("Failed to commit a successful allocation to the memory ledger.");
+    return ACL_ERROR_FAILURE;
+}
+
+static rtError_t reserve_memory(size_t size, memory_reservation_t **reservation)
+{
+    int result = memory_reserve(size, reservation);
+    if (result != ENPU_SUCCESS) {
+        LOG_ERROR("Memory reservation rejected for requested:%zu.", size);
+    }
+    return result;
+}
+
