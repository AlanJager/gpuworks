+
+#define MEMORY_LEDGER_MAGIC UINT64_C(0x454E50554D454D31) /* ENPUMEM1 */
+#define MEMORY_LEDGER_VERSION 1U
+#define MEMORY_LEDGER_PROCESS_SLOTS 64U
+#define MEMORY_LEDGER_NAME_LEN 160U
+
+typedef struct {
+    int64_t pid;
+    uint64_t start_time_ticks;
+    uint64_t used;
+} memory_process_slot_t;
+
+typedef struct {
+    uint64_t magic;
+    uint32_t version;
+    uint32_t structure_size;
+    uint64_t quota;
+    uint64_t used;
+    memory_process_slot_t processes[MEMORY_LEDGER_PROCESS_SLOTS];
+} memory_shared_ledger_t;
+
+struct memory_reservation {
+    uintptr_t key;
+    size_t size;
+    memory_allocation_kind_t kind;
+    struct memory_reservation *next;
+};
+
+static pthread_mutex_t g_ledger_init_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t g_ledger_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t g_allocation_mutex = PTHREAD_MUTEX_INITIALIZER;
+static memory_shared_ledger_t *g_ledger = NULL;
+static int g_ledger_fd = -1;
+static int g_process_slot = -1;
+static pid_t g_process_pid = 0;
+static uint64_t g_process_start_time = 0;
+static memory_reservation_t *g_allocations = NULL;
+
+static int read_process_start_time(pid_t pid, uint64_t *start_time)
+{
+    char path[64];
+    char buffer[1024];
+    int rc = snprintf(path, sizeof(path), "/proc/%ld/stat", (long)pid);
+    if (rc < 0 || (size_t)rc >= sizeof(path)) {
+        return ENPU_FAIL;
+    }
+
+    FILE *file = fopen(path, "r");
+    if (file == NULL) {
+        return ENPU_FAIL;
+    }
+    char *line = fgets(buffer, sizeof(buffer), file);
+    (void)fclose(file);
+    if (line == NULL) {
+        return ENPU_FAIL;
+    }
+
+    char *cursor = strrchr(buffer, ')');
+    if (cursor == NULL || cursor[1] != ' ') {
+        return ENPU_FAIL;
+    }
+    cursor += 2;
+    for (int field = 3; field <= 22; ++field) {
+        char *end = strchr(cursor, ' ');
+        if (field == 22) {
+            errno = 0;
+            char *number_end = NULL;
+            unsigned long long value = strtoull(cursor, &number_end, 10);
+            if (errno != 0 || number_end == cursor) {
+                return ENPU_FAIL;
+            }
+            *start_time = (uint64_t)value;
+            return ENPU_SUCCESS;
+        }
+        if (end == NULL) {
+            return ENPU_FAIL;
+        }
+        cursor = end + 1;
+    }
+    return ENPU_FAIL;
+}
+
+static bool process_slot_is_alive(const memory_process_slot_t *slot)
+{
+    uint64_t start_time = 0;
+    if (slot->pid <= 0 || read_process_start_time((pid_t)slot->pid, &start_time) != ENPU_SUCCESS) {
+        return false;
+    }
+    return start_time == slot->start_time_ticks;
+}
+
+static void reclaim_dead_processes_locked(void)
+{
+    for (size_t index = 0; index < MEMORY_LEDGER_PROCESS_SLOTS; ++index) {
+        memory_process_slot_t *slot = &g_ledger->processes[index];
+        if (slot->pid == 0 || process_slot_is_alive(slot)) {
+            continue;
+        }
+        if (slot->used > g_ledger->used) {
+            g_ledger->used = 0;
+        } else {
+            g_ledger->used -= slot->used;
+        }
+        (void)memset(slot, 0, sizeof(*slot));
+    }
+}
+
+static int find_or_create_process_slot_locked(void)
+{
+    pid_t pid = getpid();
+    uint64_t start_time = 0;
+    if (read_process_start_time(pid, &start_time) != ENPU_SUCCESS) {
+        LOG_ERROR("Failed to read process start time for memory accounting.");
+        return ENPU_FAIL;
+    }
+
+    if (g_process_slot >= 0 && g_process_pid == pid && g_process_start_time == start_time) {
+        memory_process_slot_t *slot = &g_ledger->processes[g_process_slot];
+        if (slot->pid == pid && slot->start_time_ticks == start_time) {
+            return ENPU_SUCCESS;
+        }
+    }
+
+    g_process_slot = -1;
+    for (size_t index = 0; index < MEMORY_LEDGER_PROCESS_SLOTS; ++index) {
+        memory_process_slot_t *slot = &g_ledger->processes[index];
+        if (slot->pid == pid && slot->start_time_ticks == start_time) {
+            g_process_slot = (int)index;
+            break;
+        }
+    }
+    if (g_process_slot < 0) {
+        for (size_t index = 0; index < MEMORY_LEDGER_PROCESS_SLOTS; ++index) {
+            memory_process_slot_t *slot = &g_ledger->processes[index];
+            if (slot->pid != 0) {
+                continue;
+            }
+            slot->pid = pid;
+            slot->start_time_ticks = start_time;
+            slot->used = 0;
+            g_process_slot = (int)index;
+            break;
+        }
+    }
+    if (g_process_slot < 0) {
+        LOG_ERROR("No free process slot in the shared memory ledger.");
+        return ENPU_FAIL;
+    }
+
+    g_process_pid = pid;
+    g_process_start_time = start_time;
+    return ENPU_SUCCESS;
+}
+
+static int lock_ledger(void)
+{
+    if (pthread_mutex_lock(&g_ledger_mutex) != 0) {
+        return ENPU_FAIL;
+    }
+    if (g_ledger_fd < 0 || flock(g_ledger_fd, LOCK_EX) != 0) {
+        LOG_ERROR("Failed to lock shared memory ledger, errno:%s.", strerror(errno));
+        (void)pthread_mutex_unlock(&g_ledger_mutex);
+        return ENPU_FAIL;
+    }
+    return ENPU_SUCCESS;
+}
+
+static void unlock_ledger(void)
+{
+    if (g_ledger_fd >= 0 && flock(g_ledger_fd, LOCK_UN) != 0) {
+        LOG_ERROR("Failed to unlock shared memory ledger, errno:%s.", strerror(errno));
+    }
+    (void)pthread_mutex_unlock(&g_ledger_mutex);
+}
+
+static int initialize_shared_ledger(void)
+{
+    if (g_ledger != NULL) {
+        return ENPU_SUCCESS;
+    }
+
+    int rc = pthread_mutex_lock(&g_ledger_init_mutex);
+    if (rc != 0) {
+        return ENPU_FAIL;
+    }
+    if (g_ledger != NULL) {
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_SUCCESS;
+    }
+
+    char name[MEMORY_LEDGER_NAME_LEN];
+    rc = snprintf(name, sizeof(name), "/enpu-vmem-%s-%u", get_vnpu_shm_id(), (unsigned int)get_vnpu_id());
+    if (rc < 0 || (size_t)rc >= sizeof(name)) {
+        LOG_ERROR("The shared memory ledger name is too long.");
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+
+    int fd = shm_open(name, O_CREAT | O_RDWR, S_IRUSR | S_IWUSR);
+    if (fd < 0) {
+        LOG_ERROR("Failed to open shared memory ledger %s, errno:%s.", name, strerror(errno));
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+    if (flock(fd, LOCK_EX) != 0) {
+        LOG_ERROR("Failed to initialize shared memory ledger lock, errno:%s.", strerror(errno));
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+
+    struct stat stat_buffer;
+    if (fstat(fd, &stat_buffer) != 0) {
+        LOG_ERROR("Failed to stat shared memory ledger, errno:%s.", strerror(errno));
+        (void)flock(fd, LOCK_UN);
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+    bool new_ledger = stat_buffer.st_size == 0;
+    if (new_ledger && ftruncate(fd, (off_t)sizeof(memory_shared_ledger_t)) != 0) {
+        LOG_ERROR("Failed to size shared memory ledger, errno:%s.", strerror(errno));
+        (void)flock(fd, LOCK_UN);
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+    if (!new_ledger && stat_buffer.st_size != (off_t)sizeof(memory_shared_ledger_t)) {
+        LOG_ERROR("Shared memory ledger size mismatch: found %lld, expected %zu.", (long long)stat_buffer.st_size,
+                  sizeof(memory_shared_ledger_t));
+        (void)flock(fd, LOCK_UN);
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+
+    memory_shared_ledger_t *ledger = mmap(NULL, sizeof(*ledger), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    if (ledger == MAP_FAILED) {
+        LOG_ERROR("Failed to map shared memory ledger, errno:%s.", strerror(errno));
+        (void)flock(fd, LOCK_UN);
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+
+    if (new_ledger) {
+        (void)memset(ledger, 0, sizeof(*ledger));
+        ledger->magic = MEMORY_LEDGER_MAGIC;
+        ledger->version = MEMORY_LEDGER_VERSION;
+        ledger->structure_size = (uint32_t)sizeof(*ledger);
+        ledger->quota = get_mem_limit_quota();
+    } else if (ledger->magic != MEMORY_LEDGER_MAGIC || ledger->version != MEMORY_LEDGER_VERSION ||
+               ledger->structure_size != sizeof(*ledger)) {
+        LOG_ERROR("Unsupported or corrupt shared memory ledger.");
+        (void)munmap(ledger, sizeof(*ledger));
+        (void)flock(fd, LOCK_UN);
+        (void)close(fd);
+        (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+        return ENPU_FAIL;
+    }
+
+    g_ledger = ledger;
+    g_ledger_fd = fd;
+    reclaim_dead_processes_locked();
+    if (g_ledger->quota != get_mem_limit_quota()) {
+        if (g_ledger->used != 0) {
+            LOG_ERROR("Memory quota changed while the shared ledger is in use: old:%" PRIu64 " new:%zu.",
+                      g_ledger->quota, get_mem_limit_quota());
+            g_ledger = NULL;
+            g_ledger_fd = -1;
+            (void)munmap(ledger, sizeof(*ledger));
+            (void)flock(fd, LOCK_UN);
+            (void)close(fd);
+            (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+            return ENPU_FAIL;
+        }
+        g_ledger->quota = get_mem_limit_quota();
+    }
+    rc = find_or_create_process_slot_locked();
+    (void)flock(fd, LOCK_UN);
+    (void)pthread_mutex_unlock(&g_ledger_init_mutex);
+    return rc;
+}
+
+static void refund_locked(size_t size)
+{
+    if (g_process_slot < 0) {
+        return;
+    }
+    memory_process_slot_t *slot = &g_ledger->processes[g_process_slot];
+    uint64_t refund = (uint64_t)size;
+    if (refund > slot->used) {
+        refund = slot->used;
+    }
+    slot->used -= refund;
+    if (refund > g_ledger->used) {
+        g_ledger->used = 0;
+    } else {
+        g_ledger->used -= refund;
+    }
+}
+
+int memory_reserve(size_t size, memory_reservation_t **reservation)
+{
+    if (reservation == NULL) {
+        return ACL_ERROR_FAILURE;
+    }
+    *reservation = NULL;
+
+    memory_reservation_t *entry = calloc(1, sizeof(*entry));
+    if (entry == NULL) {
+        return ACL_ERROR_FAILURE;
+    }
+    entry->size = size;
+
+    if (initialize_shared_ledger() != ENPU_SUCCESS || lock_ledger() != ENPU_SUCCESS) {
+        free(entry);
+        return ACL_ERROR_FAILURE;
+    }
+    reclaim_dead_processes_locked();
+    if (find_or_create_process_slot_locked() != ENPU_SUCCESS) {
+        unlock_ledger();
+        free(entry);
+        return ACL_ERROR_FAILURE;
+    }
+
+    uint64_t total = 0;
+    if (__builtin_add_overflow(g_ledger->used, (uint64_t)size, &total) || total > g_ledger->quota) {
+        LOG_ERROR("Out of memory! Request:%zu B, accounted:%" PRIu64 " B, quota:%" PRIu64 " B.", size,
+                  g_ledger->used, g_ledger->quota);
+        unlock_ledger();
+        free(entry);
+        return ACL_ERROR_STORAGE_OVER_LIMIT;
+    }
+
+    g_ledger->used = total;
+    g_ledger->processes[g_process_slot].used += (uint64_t)size;
+    unlock_ledger();
+    *reservation = entry;
+    return ENPU_SUCCESS;
+}
+
+int memory_commit(memory_reservation_t *reservation, uintptr_t key, memory_allocation_kind_t kind)
+{
+    if (reservation == NULL) {
+        return ENPU_FAIL;
+    }
+    if (reservation->size == 0) {
+        free(reservation);
+        return ENPU_SUCCESS;
+    }
+    if (key == 0) {
+        memory_cancel(reservation);
+        return ENPU_FAIL;
+    }
+
+    reservation->key = key;
+    reservation->kind = kind;
+    int rc = pthread_mutex_lock(&g_allocation_mutex);
+    if (rc != 0) {
+        memory_cancel(reservation);
+        return ENPU_FAIL;
+    }
+    reservation->next = g_allocations;
+    g_allocations = reservation;
+    (void)pthread_mutex_unlock(&g_allocation_mutex);
+    return ENPU_SUCCESS;
+}
+
+void memory_cancel(memory_reservation_t *reservation)
+{
+    if (reservation == NULL) {
+        return;
+    }
+    if (g_ledger != NULL && lock_ledger() == ENPU_SUCCESS) {
+        if (find_or_create_process_slot_locked() == ENPU_SUCCESS) {
+            refund_locked(reservation->size);
+        }
+        unlock_ledger();
+    }
+    free(reservation);
+}
+
+void memory_release(uintptr_t key, memory_allocation_kind_t kind)
+{
+    memory_reservation_t *found = NULL;
+    if (pthread_mutex_lock(&g_allocation_mutex) != 0) {
+        return;
+    }
+    memory_reservation_t **cursor = &g_allocations;
+    while (*cursor != NULL) {
+        if ((*cursor)->key == key && (*cursor)->kind == kind) {
+            found = *cursor;
+            *cursor = found->next;
+            break;
+        }
+        cursor = &(*cursor)->next;
+    }
+    (void)pthread_mutex_unlock(&g_allocation_mutex);
+    if (found == NULL) {
+        return;
+    }
+
+    if (g_ledger != NULL && lock_ledger() == ENPU_SUCCESS) {
+        if (find_or_create_process_slot_locked() == ENPU_SUCCESS) {
+            refund_locked(found->size);
+        }
+        unlock_ledger();
+    }
+    free(found);
+}
+
+int memory_accounted_used(size_t *used)
+{
+    if (used == NULL || initialize_shared_ledger() != ENPU_SUCCESS || lock_ledger() != ENPU_SUCCESS) {
+        return ENPU_FAIL;
+    }
+    reclaim_dead_processes_locked();
+    *used = (size_t)g_ledger->used;
+    unlock_ledger();
+    return ENPU_SUCCESS;
+}
+
+__attribute__((destructor)) static void memory_ledger_process_exit(void)
+{
+    if (g_ledger == NULL || g_ledger_fd < 0 || lock_ledger() != ENPU_SUCCESS) {
+        return;
+    }
+    if (g_process_slot >= 0) {
+        memory_process_slot_t *slot = &g_ledger->processes[g_process_slot];
+        if (slot->pid == g_process_pid && slot->start_time_ticks == g_process_start_time) {
+            refund_locked((size_t)slot->used);
+            (void)memset(slot, 0, sizeof(*slot));
+        }
+    }
+    unlock_ledger();
+}
