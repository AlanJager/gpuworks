 typedef LIST_HEAD(tracees, tracee) Tracees;
 static Tracees tracees;
 
+/* get_tracee() is called for every event of every tracee and
+ * free_terminated_tracees() once per event.  Both walked the whole
+ * list of tracees, so with thousands of threads the two linear walks
+ * cost more CPU than the ptrace(2) calls they accompany.  Index the
+ * tracees by pid and keep a count of the terminated ones so that both
+ * become O(1) in the common case.  The order in which events are
+ * served is not affected.  */
+#define TRACEE_INDEX_SIZE 1024 /* A power of two.  */
+typedef LIST_HEAD(tracee_bucket, tracee) TraceeBucket;
+static TraceeBucket tracee_index[TRACEE_INDEX_SIZE];
+static size_t nb_terminated_tracees;
+
+static TraceeBucket *tracee_bucket(pid_t pid)
+{
+	/* Knuth's multiplicative hash; pids are dense and the low bits
+	 * alone would cluster.  */
+	uint32_t hash = (uint32_t) pid * UINT32_C(2654435761);
+
+	return &tracee_index[hash & (TRACEE_INDEX_SIZE - 1)];
+}
+
+static void unindex_tracee(Tracee *tracee)
+{
+	if (!tracee->indexed)
+		return;
+	LIST_REMOVE(tracee, index_link);
+	tracee->indexed = false;
+}
+
+/**
+ * Set @tracee's pid to @pid, keeping the pid index consistent.  Every
+ * assignment to Tracee.pid has to go through this function.
+ */
+void set_tracee_pid(Tracee *tracee, pid_t pid)
+{
+	unindex_tracee(tracee);
+	tracee->pid = pid;
+	LIST_INSERT_HEAD(tracee_bucket(pid), tracee, index_link);
+	tracee->indexed = true;
+}
+
 
