--- a/src/path/temp.c	2023-05-13 15:08:11
+++ b/src/path/temp.c	2026-08-18 22:43:53
@@ -241,8 +241,15 @@
 	if (cwd != NULL) {
 		status = chdir(cwd);
 		if (status < 0) {
-			result = -1;
-			note(NULL, ERROR, SYSTEM, "can't chdir to '%s'", cwd);
+			/* Best-effort restore: this function is only used as a
+			 * talloc destructor whose result is discarded.  Restoring
+			 * a guest-side cwd (e.g. "/root" when the container user
+			 * is root) fails on the host for non-root users, which is
+			 * expected and harmless: fall back to "/" silently.  */
+			if (chdir("/") < 0) {
+				result = -1;
+				note(NULL, ERROR, SYSTEM, "can't chdir to '%s'", cwd);
+			}
 		}
 		free(cwd);
 	}
