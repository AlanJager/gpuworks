 static TraceeBucket tracee_index[TRACEE_INDEX_SIZE];
 static size_t nb_terminated_tracees;
 
+/* How many tracees are alive right now.  The event loop needs it to
+ * know how expensive a waitpid(2) scan of the whole children list has
+ * become.  */
+static size_t nb_tracees;
+
+size_t get_nb_tracees(void)
+{
+	return nb_tracees;
+}
+
 static TraceeBucket *tracee_bucket(pid_t pid)
 {
 	/* Knuth's multiplicative hash; pids are dense and the low bits
@@ -135,6 +145,8 @@ static int remove_tracee(Tracee *tracee)
 
 	LIST_REMOVE(tracee, link);
 	unindex_tracee(tracee);
+	assert(nb_tracees > 0);
+	nb_tracees--;
 	if (tracee->terminated) {
 		assert(nb_terminated_tracees > 0);
 		nb_terminated_tracees--;
@@ -276,6 +288,7 @@ static Tracee *new_tracee(pid_t pid)
 	tracee->vpid = next_vpid++;
 
 	LIST_INSERT_HEAD(&tracees, tracee, link);
+	nb_tracees++;
 
 	tracee->life_context = talloc_new(tracee);
 
