+    def get_replay_boundaries(self, request):
+        # Match the read-side last-block policy. Otherwise sparse retention
+        # keeps a shifted checkpoint that standalone/producer lookups never
+        # select, and the actual replay boundary is discarded.
+        if self.skips_eagle_block_drop:
+            boundary = request.num_prompt_tokens - 1
+            # Mixed Mamba/SWA groups can round the replay point to different
+            # physical pages. Preserve the SWA window at the common page
+            # boundary as well as at a possible fine-grained Mamba tail.
+            specs = [group.spec for group in self.attention_groups]
+            if any(isinstance(spec, MambaSpec) for spec in specs) and any(
+                isinstance(spec, SlidingWindowSpec) for spec in specs
+            ):
+                aligned = boundary // self.lcm_block_size * self.lcm_block_size
+                return (boundary, aligned) if aligned != boundary else (boundary,)
+            return (boundary,)
+        return super().get_replay_boundaries(request)
 
