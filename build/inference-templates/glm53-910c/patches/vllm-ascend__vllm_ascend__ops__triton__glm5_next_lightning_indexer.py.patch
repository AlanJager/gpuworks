+@triton.jit(do_not_specialize=["rows", "max_pool_seq_len", "num_reqs", "num_cache_blocks"])
+def _glm5_next_indexer_query_reuse_kernel(
+    qbar, cache, query_ends, pool_lens, block_table, positions, output,
+    rows, max_pool_seq_len, num_reqs, num_cache_blocks,
+    CACHE_SB: tl.constexpr, CACHE_ST: tl.constexpr, CACHE_SD: tl.constexpr,
+    TABLE_SR: tl.constexpr, TABLE_SP: tl.constexpr,
+    CACHE_BLOCK: tl.constexpr, HEAD_DIM: tl.constexpr, POOL: tl.constexpr,
+    BLOCK_POOL: tl.constexpr, LOWEST: tl.constexpr,
+):
+    # Queries in one request read the same pooled keys. Keep a key tile in
+    # local memory while reducing each query, preserving FP32 score arithmetic.
+    chunks = tl.cdiv(max_pool_seq_len, BLOCK_POOL)
+    for tile in range(tl.program_id(0), (num_reqs + 1) * chunks, tl.num_programs(0)):
+        request, chunk = tile // chunks, tile % chunks
+        row_start = tl.load(query_ends + request - 1, request > 0, other=0)
+        row_end = tl.load(query_ends + request, request < num_reqs, other=rows)
+        row_start = tl.minimum(row_start, rows)
+        row_end = tl.minimum(row_end, rows)
+        if row_start < row_end:
+            pools = chunk * BLOCK_POOL + tl.arange(0, BLOCK_POOL)
+            dims = tl.arange(0, HEAD_DIM)
+            if request < num_reqs:
+                pool_length = tl.load(pool_lens + request)
+                valid = (pools < max_pool_seq_len) & (pools < pool_length)
+                blocks = tl.load(
+                    block_table + request * TABLE_SR + (pools // CACHE_BLOCK) * TABLE_SP,
+                    valid, other=0,
+                )
+                blocks = tl.minimum(tl.maximum(blocks, 0), num_cache_blocks - 1)
+                offsets = blocks[:, None] * CACHE_SB + (pools % CACHE_BLOCK)[:, None] * CACHE_ST
+                keys = tl.load(cache + offsets + dims[None, :] * CACHE_SD,
+                               valid[:, None], other=0).to(tl.float32)
+                # Reduce two queries together while retaining the same FP32
+                # products and head-dimension reduction as the single-row path.
+                for row in range(row_start, row_end, 2):
+                    query_rows = row + tl.arange(0, 2)
+                    query_valid = query_rows < row_end
+                    weighted_query = tl.load(
+                        qbar + query_rows[:, None] * HEAD_DIM + dims[None, :],
+                        query_valid[:, None], other=0,
+                    )
+                    position = tl.load(positions + query_rows, query_valid, other=0).to(tl.int32)
+                    visible = tl.minimum((position + 1) // POOL, pool_length)
+                    scores = tl.sum(keys[None, :, :] * weighted_query[:, None, :], axis=2)
+                    scores = tl.where(
+                        (pools[None, :] < visible[:, None]) & (scores == scores),
+                        tl.minimum(tl.maximum(scores, LOWEST), -LOWEST), LOWEST,
+                    )
+                    tl.store(
+                        output + query_rows[:, None] * max_pool_seq_len + pools[None, :],
+                        scores, query_valid[:, None] & (pools[None, :] < max_pool_seq_len),
+                    )
+            else:
+                for row in range(row_start, row_end):
+                    tl.store(output + row * max_pool_seq_len + pools, LOWEST, pools < max_pool_seq_len)
 
 
