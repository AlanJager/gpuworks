+def _ninja_log_library_complete(build_directory, initial_log_size):
+    try:
+        with open(os.path.join(build_directory, ".ninja_log"), "rb") as log:
+            log.seek(initial_log_size)
+            entries = log.read().decode(errors="replace").splitlines()
+        for entry in entries:
+            fields = entry.split("\t")
+            if len(fields) >= 4 and fields[3].endswith(".so") and os.path.getsize(os.path.join(build_directory, fields[3])) > 0:
+                return True
+    except OSError:
+        pass
+    return False
+
+
+def _run_ninja_build_without_waitpid(build_directory, verbose, error_prefix):
+    command = ["ninja", "-v"]
+    workers = cpp_extension._get_num_workers(verbose)
+    if workers is not None:
+        command.extend(["-j", str(workers)])
+    try:
+        initial_log_size = os.path.getsize(os.path.join(build_directory, ".ninja_log"))
+    except OSError:
+        initial_log_size = 0
+    process = subprocess.Popen(
+        command,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        cwd=build_directory,
+        env=os.environ.copy(),
+    )
+    chunks = []
+    assert process.stdout is not None
+    os.set_blocking(process.stdout.fileno(), False)
+    while True:
+        ready, _, _ = select.select([process.stdout], [], [], 0.1)
+        if ready:
+            chunk = process.stdout.read(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+            if verbose:
+                os.write(1, chunk)
+        output = b"".join(chunks)
+        if b"FAILED:" in output or b"ninja: build stopped" in output:
+            break
+        if _ninja_log_library_complete(build_directory, initial_log_size):
+            break
+    print(f"CANN_STAGE ninja return {build_directory}", flush=True)
+    process.returncode = 0
+    process.stdout.close()
+    output = b"".join(chunks)
+    if b"FAILED:" in output or b"ninja: build stopped" in output:
+        raise RuntimeError(error_prefix + ": " + output.decode(errors="replace"))
+
+
+if os.environ.get("GPUWORKS_RUNVEIL_WAITPID_WORKAROUND") == "1":
+    cpp_extension._run_ninja_build = _run_ninja_build_without_waitpid
+    faulthandler.register(signal.SIGUSR1)
+    _import_library = cpp_extension._import_module_from_library
+
+    def _diagnostic_import_library(name, path, is_python_module):
+        print("CANN_STAGE import start " + name, flush=True)
+        result = _import_library(name, path, is_python_module)
+        print("CANN_STAGE import done " + name, flush=True)
+        return result
+
+    cpp_extension._import_module_from_library = _diagnostic_import_library
+
