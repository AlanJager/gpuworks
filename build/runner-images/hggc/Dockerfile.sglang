# gpuworks-runner: T-Head PPU（HGGC）SGLang 线
#
# 派生自 gpustack/runner 的 pack/hggc/Dockerfile.sglang（Apache-2.0，见 ../NOTICE）。
#
# 与 vllm 线同一 vanilla（asllm 自带 sglang 0.5.13+asllm2.0.0.8 与 diffusion 全家），
# rootfs 完全相同，只有 label 与引擎标识不同；sglang 本体与 diffusers 均继承 vanilla。
# 同样必须配合 build.sh --squash（厂商 history 含明文凭据，理由见 Dockerfile.vllm）。
ARG BASE_IMAGE=asllm:2.0.0-vanilla
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

ARG TARGETPLATFORM
ARG SGLANG_VERSION=0.5.13
ARG IMAGE_ID=unknown
ARG IMAGE_REVISION=unknown
ARG REQUIRES="engine overlays"

ENV DEBIAN_FRONTEND=noninteractive

RUN <<EOF
    set -eux
    if command -v apt-get >/dev/null 2>&1; then
        apt-get update -y
        apt-get install -y --no-install-recommends \
            tini jq curl wget vim less tree bc \
            iproute2 iputils-ping net-tools dnsutils \
            procps sysstat htop \
            ffmpeg patch
        rm -rf /var/cache/apt /var/tmp/* /tmp/*
    else
        yum install -y jq curl wget vim less tree bc iproute iputils net-tools procps-ng sysstat htop ffmpeg patch
        rm -rf /var/cache/yum /tmp/*
    fi
EOF

## 厂商 base 的运行期 env 里带着 T-Head 内网的包源（`PIP_INDEX_URL`、`PYTHON_PKG_URL`、
## `PYTHON_GET_PIP_URL`，域名 *.eng.t-head.cn，不含凭据，2026-10-06 在 PPU 上复验发现）。
## 外部用户在容器里 `pip install` 会走到连不上的内网源，所以改回公网默认源、清空另外两个
## （它们只在厂商构建镜像时用）。ENV 只改元数据，不增加文件层。
ENV BASH_ENV="" \
    PIP_INDEX_URL="https://pypi.org/simple" \
    PYTHON_PKG_URL="" \
    PYTHON_GET_PIP_URL="" \
    VLLM_USE_V1=0 \
    RAY_EXPERIMENTAL_NOSET_CUDA_VISIBLE_DEVICES=1

## 厂商 base 还在 /etc/profile.d/dockerenv.sh 里无条件 export 了同样的内网变量（外加
## BASH_ENV=autocache-init.sh），登录 shell（terminal、`docker exec -it … bash -l`）会把上面清掉的
## 值全部还原回去（2026-10-06 在 PPU 上复验发现）。把这几行从脚本和 /etc/instanceInfo 的 dump 里删掉。
RUN <<EOF
    set -eux
    for f in /etc/profile.d/dockerenv.sh /etc/instanceInfo; do
        [ -f "$f" ] || continue
        sed -i -E '/t-head\.cn|^export BASH_ENV=|^BASH_ENV=/d' "$f"
    done
    if grep -rlE 't-head\.cn' /etc/profile.d /etc/instanceInfo 2>/dev/null; then
        echo "vendor-internal hosts still present in login-shell config" >&2
        exit 1
    fi
EOF

WORKDIR /
ENTRYPOINT [ "tini", "--" ]

COPY overlays/ /opt/gpuworks/overlays/

## PPU 同机 PD（pdmode sglang-ppu-ipc）：给 sglang 的 mooncake 后端打补丁，只在
## SGLANG_PPU_PD_IPC=1 / SGLANG_PPU_PD_SERIAL_TRANSFER=1 时生效，普通部署不受影响。
## 补丁逐处按原文锚定，锚点不在就构建失败，不猜。说明见 hggc/ppu-pd/install_ppu_pd_ipc.py。
COPY hggc/ppu-pd/ /opt/gpuworks/ppu-pd/
RUN python3 /opt/gpuworks/ppu-pd/install_ppu_pd_ipc.py

COPY shared/assert_requires.sh /opt/gpuworks/shared/assert_requires.sh
RUN <<EOF
    set -eux
    python3 - <<'PY' > /opt/gpuworks/image.json
import json, os
json.dump({
    "id": os.environ["IMAGE_ID"],
    "revision": os.environ["IMAGE_REVISION"],
    "engine": "sglang",
    "engine_version": os.environ["SGLANG_VERSION"],
    "framework": "hggc",
    "requires": os.environ["REQUIRES"].split(),
}, open("/dev/stdout", "w"), indent=2, sort_keys=True)
PY
    REQUIRES="${REQUIRES}" ENGINE=sglang bash /opt/gpuworks/shared/assert_requires.sh
EOF

LABEL org.opencontainers.image.title="gpuworks-runner" \
      org.opencontainers.image.vendor="gpuworks" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      io.gpuworks.image.id="${IMAGE_ID}" \
      io.gpuworks.engine="sglang-hggc" \
      io.gpuworks.framework="hggc" \
      io.gpuworks.framework.version="13.0" \
      io.gpuworks.ppu-sdk="2.1.0" \
      io.gpuworks.diffusion="inherited-diffusers0.37.0" \
      io.gpuworks.requires="${REQUIRES}"
