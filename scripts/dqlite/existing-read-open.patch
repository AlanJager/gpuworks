+/* Restrict this capability to a plain database name, never a path or URI. */
+static bool plainDatabaseName(const char *name)
+{
+	size_t n = strlen(name);
+	if (n == 0 || n > 511 || strcmp(name, ".") == 0 ||
+	    strcmp(name, "..") == 0) {
+		return false;
+	}
+	for (size_t i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)name[i];
+		if (c < 0x20 || c == 0x7f || c == '/' || c == '\\' ||
+		    c == ':' || c == '?') {
+			return false;
+		}
+	}
+	return true;
+}
+
+static int handle_open_existing_read(struct gateway *g, struct handle *req)
+{
+	struct cursor *cursor = &req->cursor;
+	struct db *db;
+	int rc;
+	START_V0(open_existing_read, db);
+	if (cursor->cap != 0 || request.flags != 0 ||
+	    strcmp(request.vfs, "volatile") != 0 ||
+	    !plainDatabaseName(request.filename)) {
+		failure(req, DQLITE_PARSE, "invalid existing read-only open");
+		return 0;
+	}
+	CHECK_LEADER(req);
+	if (g->leader != NULL) {
+		failure(req, SQLITE_BUSY,
+			"a database for this connection is already open");
+		return 0;
+	}
+
+	/* Restore and applied OPEN commands populate this registry. A read-only
+	 * client must not create even a missing registry record. */
+	db = registry__get(g->registry, request.filename);
+	if (db == NULL) {
+		failure(req, SQLITE_CANTOPEN, "existing database not loaded");
+		return 0;
+	}
+	g->leader = raft_malloc(sizeof *g->leader);
+	if (g->leader == NULL) {
+		return DQLITE_NOMEM;
+	}
+	rc = leader__init_existing_read(g->leader, db, g->raft);
+	if (rc != 0) {
+		raft_free(g->leader);
+		g->leader = NULL;
+		failure(req, rc, "existing read-only database open failed");
+		return 0;
 	}
 	g->leader->data = g;
 	response.id = 0;
