 /******************************************************************************
  *
+ * Slow io_destroy(2), interposed at link time with -Wl,--wrap=io_destroy.
+ *
+ *****************************************************************************/
+
+int __real_io_destroy(aio_context_t ctx);
+int __wrap_io_destroy(aio_context_t ctx);
+
+static unsigned slowDestroyMsecs;   /* Sleep this long before destroying */
+static unsigned slowDestroyStarted; /* Destroys entered while slowed down */
+static unsigned slowDestroyDone;    /* Destroys completed while slowed down */
+
+int __wrap_io_destroy(aio_context_t ctx)
+{
+    unsigned msecs = __atomic_load_n(&slowDestroyMsecs, __ATOMIC_SEQ_CST);
+    int rv;
+    if (msecs != 0) {
+        struct timespec ts = {msecs / 1000, (long)(msecs % 1000) * 1000000};
+        __atomic_add_fetch(&slowDestroyStarted, 1, __ATOMIC_SEQ_CST);
+        nanosleep(&ts, NULL);
+    }
+    rv = __real_io_destroy(ctx);
+    if (msecs != 0) {
+        __atomic_add_fetch(&slowDestroyDone, 1, __ATOMIC_SEQ_CST);
+    }
+    return rv;
+}
+
+struct slowClose
+{
+    bool closed;
+    unsigned started; /* Destroys entered when the instance reported closed */
+    unsigned done;    /* Destroys completed at that time */
+};
+
+static void slowCloseCb(struct raft_io *io)
+{
+    struct slowClose *c = io->data;
+    c->started = __atomic_load_n(&slowDestroyStarted, __ATOMIC_SEQ_CST);
+    c->done = __atomic_load_n(&slowDestroyDone, __ATOMIC_SEQ_CST);
+    c->closed = true;
+}
+
