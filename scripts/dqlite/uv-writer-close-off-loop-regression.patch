+/* The instance reports closed only after every segment writer has released its
+ * KAIO context, however long the kernel takes. Nothing may refer to the
+ * instance afterwards. */
+TEST(append, closeWaitsForSlowWriterRelease, setUp, tearDownDeps, 0, NULL)
+{
+    struct fixture *f = data;
+    struct slowClose c = {false, 0, 0};
+    uint64_t deadline = uv_hrtime() + 30 * 1000000000ULL;
+    APPEND(MAX_SEGMENT_BLOCKS, SEGMENT_BLOCK_SIZE);
+    APPEND(1, 64);
+    __atomic_store_n(&slowDestroyStarted, 0, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&slowDestroyDone, 0, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&slowDestroyMsecs, 300, __ATOMIC_SEQ_CST);
+    f->io.data = &c;
+    f->io.close(&f->io, slowCloseCb);
+    while (!c.closed) {
+        munit_assert_true(uv_hrtime() < deadline);
+        uv_run(&f->loop, UV_RUN_ONCE);
+    }
+    __atomic_store_n(&slowDestroyMsecs, 0, __ATOMIC_SEQ_CST);
+    munit_assert_uint(c.started, >=, 1);
+    munit_assert_uint(c.done, ==, c.started);
+    munit_assert_uint(__atomic_load_n(&slowDestroyStarted, __ATOMIC_SEQ_CST), ==,
+                      c.started);
+    raft_uv_close(&f->io);
+    return MUNIT_OK;
+}
+
+/* Many segments are filled and finalized back to back while the kernel is slow
