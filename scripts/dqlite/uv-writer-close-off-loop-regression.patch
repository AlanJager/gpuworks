+/* Destroying the KAIO context sleeps in the kernel. The loop must keep running
+ * its timers meanwhile, and the close callback must not fire before the
+ * context is actually destroyed. */
+TEST(UvWriterClose, slowDestroy, setUp, tearDownDeps, 0, NULL)
+{
+    struct fixture *f = data;
+    struct heartbeat heartbeat = {0, 0, 0};
+    uv_timer_t timer;
+    bool timer_closed = false;
+    uint64_t deadline;
+    unsigned done;
+    int rv;
+    SKIP_IF_NO_FIXTURE;
+    WRITE(1, 0, 0);
+
+    rv = uv_timer_init(&f->loop, &timer);
+    munit_assert_int(rv, ==, 0);
+    timer.data = &heartbeat;
+    rv = uv_timer_start(&timer, heartbeatCb, 10, 10);
+    munit_assert_int(rv, ==, 0);
+
+    __atomic_store_n(&slowDestroyDone, 0, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&slowDestroyMsecs, 500, __ATOMIC_SEQ_CST);
+    heartbeat.last = uv_hrtime();
+    deadline = heartbeat.last + 20 * 1000000000ULL;
+    CLOSE_SUBMIT;
+    while (!f->closed) {
+        munit_assert_true(uv_hrtime() < deadline);
+        uv_run(&f->loop, UV_RUN_ONCE);
+    }
+    heartbeatCb(&timer); /* Account for the interval that ends now. */
+    done = __atomic_load_n(&slowDestroyDone, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&slowDestroyMsecs, 0, __ATOMIC_SEQ_CST);
+
+    timer.data = &timer_closed;
+    uv_close((uv_handle_t *)&timer, heartbeatCloseCb);
+    while (!timer_closed) {
+        uv_run(&f->loop, UV_RUN_ONCE);
+    }
+
+    /* The context was destroyed exactly once, before the close callback. */
+    munit_assert_uint(done, ==, 1);
+    /* The loop was never away for half of the time the destroy took. */
+    munit_assert_ullong(heartbeat.max_gap, <, 250 * 1000000ULL);
+    munit_assert_uint(heartbeat.ticks, >=, 10);
+    return MUNIT_OK;
+}
