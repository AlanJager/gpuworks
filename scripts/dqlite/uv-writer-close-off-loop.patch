-static void uvWriterCleanUpAndFireCloseCb(struct UvWriter *w)
+/* Release the file descriptor and the KAIO context.
+ *
+ * io_destroy() sleeps uninterruptibly until the context is quiescent, which
+ * always costs at least an RCU grace period and has no upper bound while a
+ * write is stuck in the kernel; close() can block in a file system's flush
+ * and release hooks. Both must stay off the loop thread, which drives the
+ * raft heartbeats. Nothing else refers to the descriptor or to the context
+ * at this point: the event poller is closed, every polled request has been
+ * finished and no threadpool write is in flight. */
+static void uvWriterReleaseOsResources(struct UvWriter *w)
 {
-	dqlite_assert(w->closing);
-
 	UvOsClose(w->fd);
-	RaftHeapFree(w->events);
 	UvOsIoDestroy(w->ctx);
+}
 
+static void uvWriterFireCloseCb(struct UvWriter *w)
+{
+	RaftHeapFree(w->events);
 	if (w->close_cb != NULL) {
 		w->close_cb(w);
 	}
 }
 
+static void uvWriterCloseWorkCb(uv_work_t *work)
+{
+	struct UvWriter *w = work->data;
+	uvWriterReleaseOsResources(w);
+}
+
+static void uvWriterCloseAfterWorkCb(uv_work_t *work, int status)
+{
+	struct UvWriter *w = work->data;
+	if (status != 0) {
+		/* The work never ran: release here rather than leak. */
+		uvWriterReleaseOsResources(w);
+	}
+	uvWriterFireCloseCb(w);
+}
+
+static void uvWriterCleanUpAndFireCloseCb(struct UvWriter *w)
+{
+	int rv;
+	dqlite_assert(w->closing);
+
+	w->close_work.data = w;
+	rv = uv_queue_work(w->loop, &w->close_work, uvWriterCloseWorkCb,
+			   uvWriterCloseAfterWorkCb);
+	if (rv != 0) {
+		/* UNTESTED: with the current libuv implementation this can't
+		 * fail. Fall back to releasing on the loop thread. */
+		uvWriterReleaseOsResources(w);
+		uvWriterFireCloseCb(w);
+	}
+}
