+static int encodeConfigurationServer(const struct raft_configuration *configuration,
+				     unsigned i,
+			struct buffer *buffer,
+			int format)
+{
+	char *cur;
+	uint64_t id;
+	uint64_t role;
+	text_t address;
+
+	dqlite_assert(format == DQLITE_REQUEST_CLUSTER_FORMAT_V0 ||
+	       format == DQLITE_REQUEST_CLUSTER_FORMAT_V1);
+
+	id = configuration->servers[i].id;
+	address = configuration->servers[i].address;
+	role = (uint64_t)translateRaftRole(configuration->servers[i].role);
+
+	cur = buffer__advance(buffer, uint64__sizeof(&id));
+	if (cur == NULL) {
+		return DQLITE_NOMEM;
+	}
+	uint64__encode(&id, &cur);
+
+	cur = buffer__advance(buffer, text__sizeof(&address));
+	if (cur == NULL) {
+		return DQLITE_NOMEM;
+	}
+	text__encode(&address, &cur);
+
+	if (format == DQLITE_REQUEST_CLUSTER_FORMAT_V0) {
+		return 0;
+	}
+
+	cur = buffer__advance(buffer, uint64__sizeof(&role));
+	if (cur == NULL) {
+		return DQLITE_NOMEM;
+	}
+	uint64__encode(&role, &cur);
+
+	return 0;
+}
