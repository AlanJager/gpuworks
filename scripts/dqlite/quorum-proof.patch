+static void quorumProofCb(struct raft_barrier *barrier, int status)
+{
+	struct quorum_proof *proof = barrier->data;
+	struct gateway *g = proof->gateway;
+	struct handle *req = g->req;
+	size_t response_offset = buffer__offset(req->buffer);
+	int rv = 0;
+
+	g->req = NULL;
+	if (g->close_cb != NULL) {
+		raft_free(proof);
+		/* Preserve database leader/statement cleanup before the close callback. */
+		gateway_finalize(g);
+		return;
+	}
+	if (status != 0) {
+		rv = translateRaftErrCode(status);
+	} else if (req->cancellation_requested) {
+		rv = SQLITE_INTERRUPT;
+	} else if (!quorumProofStable(proof) ||
+		   barrier->index <= proof->before_index ||
+		   barrier->index > g->raft->commit_index ||
+		   barrier->index > g->raft->last_applied) {
+		rv = SQLITE_IOERR_LEADERSHIP_LOST;
+	} else {
+		rv = encodeQuorumProof(proof, req);
+	}
+	raft_free(proof);
+	if (rv != 0) {
+		/* Encoding may have partially advanced the response buffer. */
+		/* Keep the connection's reserved response header intact. */
+		req->buffer->offset = response_offset;
+		failure(req, rv, "fresh quorum configuration unavailable");
+		return;
+	}
+	req->cb(req, 0, DQLITE_RESPONSE_SERVERS, 2);
+}
