+static bool quorumProofStable(const struct quorum_proof *proof)
+{
+	const struct raft *r = proof->gateway->raft;
+	return r->state == RAFT_LEADER && r->transfer == NULL &&
+	       r->current_term == proof->term &&
+	       r->configuration_committed_index == proof->configuration_index &&
+	       r->configuration_uncommitted_index == 0 &&
+	       r->leader_state.promotee_id == 0;
+}
