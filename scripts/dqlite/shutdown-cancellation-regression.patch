+/* A real uv backend cancels unwritten requests during close. Followers can
+ * already have committed the entry while the leader's disk remains pending. */
+extern void raft_fixture_fail_pending_appends(struct raft_io *io, int status);
+static void cancelAppliedPendingAppend(const MunitParameter params[],
+                                       struct fixture *f, bool mixed)
+{
+    struct raft *r;
+    struct sm *entry_sm;
+    struct raft_apply req = {0};
+    CLUSTER_GROW;
+    CLUSTER_SET_DISK_LATENCY(0, 10000);
+    /* The shared bootstrap macro also uses params, unused by these cases. */
+    CLUSTER_BOOTSTRAP;
+    CLUSTER_START;
+    CLUSTER_ELECT(0);
+    ASSERT_TIME(1045);
+    CLUSTER_STEP_UNTIL_APPLIED(0, 2, 2000);
+    r = CLUSTER_RAFT(0);
+    munit_assert_int(r->last_stored, ==, 1);
+    munit_assert_int(r->commit_index, ==, 2);
+    munit_assert_int(r->last_applied, ==, 2);
+    entry_sm = log_get_entry_sm(r->log, logGet(r->log, 2)->term, 2);
+    munit_assert_int(sm_state(entry_sm), ==, ENTRY_APPLIED);
+    if (mixed) {
+        CLUSTER_DISCONNECT(0, 1);
+        CLUSTER_DISCONNECT(0, 2);
+        CLUSTER_APPLY_ADD_X(0, &req, 1, NULL);
+        munit_assert_int(logLastIndex(r->log), ==, 3);
+        munit_assert_int(r->commit_index, ==, 2);
+        entry_sm = log_get_entry_sm(r->log, logGet(r->log, 3)->term, 3);
+        munit_assert_int(sm_state(entry_sm), ==, ENTRY_CREATED);
+    }
+    /* Use the real unavailable conversion with synthetic pending-cancellation
+     * callbacks. Inspect before final logClose, which normal teardown performs.
+     * This does not execute uvAppendClose, physical disk I/O or restart. */
+    convertToUnavailable(r);
+    raft_fixture_fail_pending_appends(r->io, RAFT_CANCELED);
+    munit_assert_int(r->state, ==, RAFT_UNAVAILABLE);
+    munit_assert_int(r->last_stored, ==, 1);
+    munit_assert_int(r->commit_index, ==, 2);
+    munit_assert_int(r->last_applied, ==, 2);
+    munit_assert_int(logLastIndex(r->log), ==, 2);
+    munit_assert_not_null(logGet(r->log, 2));
+    munit_assert_null(logGet(r->log, 3));
+    entry_sm = log_get_entry_sm(r->log, logGet(r->log, 2)->term, 2);
+    munit_assert_int(sm_state(entry_sm), ==, ENTRY_APPLIED);
+}
+TEST(replication, closePendingQuorumAppliedAppend, setUp, tearDown, 0, NULL)
+{
+    cancelAppliedPendingAppend(params, data, false);
+    return MUNIT_OK;
+}
+TEST(replication, closeAppliedPrefixUncommittedSuffix, setUp, tearDown, 0, NULL)
+{
+    cancelAppliedPendingAppend(params, data, true);
+    return MUNIT_OK;
+}
