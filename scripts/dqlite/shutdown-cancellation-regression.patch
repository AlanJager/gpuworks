+/* Private test helper: synthesize queued append error callbacks and release
+ * fixture request ownership without claiming any local bytes were persisted.
+ * It models uv pending-request cancellation, not real uv I/O execution. */
+void raft_fixture_fail_pending_appends(struct raft_io *raft_io, int status)
+{
+	struct io *io = raft_io->impl;
+	queue *head;
+	queue *next;
+	queue cancelled;
+	queue_init(&cancelled);
+	for (head = io->requests.next; head != &io->requests; head = next) {
+		struct ioRequest *r = QUEUE_DATA(head, struct ioRequest, queue);
+		next = head->next;
+		if (r->type == APPEND) {
+			queue_remove(head);
+			queue_insert_tail(&cancelled, head);
+		}
+	}
+	while (!queue_empty(&cancelled)) {
+		struct append *append;
+		head = queue_head(&cancelled);
+		queue_remove(head);
+		append = QUEUE_DATA(head, struct append, queue);
+		sm_fail(&append->req->sm, FIO_FAIL, status);
+		sm_fini(&append->req->sm);
+		append->req->cb(append->req, status);
+		raft_free(append);
 	}
 }
 
