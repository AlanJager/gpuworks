+func TestRPCCancelDriverErrorKeepsCurrentContext(t *testing.T) {
+	log := func(client.LogLevel, string, ...interface{}) {}
+	for _, ctxErr := range []error{context.Canceled, context.DeadlineExceeded} {
+		err := errors.Join(ctxErr, io.EOF, &net.OpError{Op: "close", Net: "pipe", Err: net.ErrClosed})
+		got := driverError(log, err)
+		if !errors.Is(got, ctxErr) || !errors.Is(got, io.EOF) || errors.Is(got, sqldriver.ErrBadConn) {
+			t.Fatalf("sentRPC replay signal/lostcloseerror: %v", got)
+		}
+	}
+	if !errors.Is(driverError(log, io.EOF), sqldriver.ErrBadConn) {
+		t.Fatal("future unsent poison not replaced")
+	}
+	live := &net.OpError{Op: "read", Net: "tcp", Err: net.ErrClosed}
+	if !errors.Is(driverError(log, live), sqldriver.ErrBadConn) {
+		t.Fatal("live network classification changed")
+	}
+	sqlErr := Error{Code: 5, Message: "database is locked"}
+	if got := driverError(log, sqlErr); got != sqlErr {
+		t.Fatalf("liveSQL errorchanged: %v", got)
+	}
+}
