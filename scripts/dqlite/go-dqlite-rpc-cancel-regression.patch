+type rpcCancelConnector struct {
+	connects, executions atomic.Int32
+	statement            string
+	seen                 chan struct{}
+	cancel               context.CancelFunc
+	mu                   sync.Mutex
+	wires                []net.Conn
+}
+type rpcCancelDriver struct{ c *rpcCancelConnector }
+
+func (d rpcCancelDriver) Open(string) (sqldriver.Conn, error) {
+	return d.c.Connect(context.Background())
+}
+func (c *rpcCancelConnector) Driver() sqldriver.Driver { return rpcCancelDriver{c} }
+func (c *rpcCancelConnector) Connect(ctx context.Context) (sqldriver.Conn, error) {
+	number := c.connects.Add(1)
+	a, b := net.Pipe()
+	c.mu.Lock()
+	c.wires = append(c.wires, a)
+	c.mu.Unlock()
+	go func() {
+		defer b.Close()
+		var handshake [8]byte
+		if _, err := io.ReadFull(b, handshake[:]); err != nil {
+			return
+		}
+		var h [8]byte
+		if _, err := io.ReadFull(b, h[:]); err != nil {
+			return
+		}
+		body := make([]byte, int(binary.LittleEndian.Uint32(h[:]))*8)
+		if _, err := io.ReadFull(b, body); err != nil {
+			return
+		}
+		if strings.Contains(string(body), c.statement) {
+			c.executions.Add(1)
+		}
+		if number > 1 {
+			var response [24]byte
+			binary.LittleEndian.PutUint32(response[:4], 2)
+			response[4] = protocol.ResponseResult
+			binary.LittleEndian.PutUint64(response[16:], 1)
+			_, _ = b.Write(response[:])
+			return
+		}
+		close(c.seen)
+		c.cancel()
+		var one [1]byte
+		_, _ = b.Read(one[:])
+	}()
+	p, err := protocol.Handshake(ctx, a, protocol.VersionOne, "pipe")
+	if err != nil {
+		return nil, err
+	}
+	conn := &Conn{protocol: p, log: func(client.LogLevel, string, ...interface{}) {}, tracing: client.LogNone}
+	conn.request.Init(256)
+	conn.response.Init(256)
+	return conn, nil
+}
+
+func TestRPCCancelDriverSendsUncertainExecOnce(t *testing.T) {
+	for _, statement := range []string{"INSERT INTO rpc_cancel VALUES(1)", "COMMIT"} {
+		t.Run(statement, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			c := &rpcCancelConnector{statement: statement, seen: make(chan struct{}), cancel: cancel}
+			db := sql.OpenDB(c)
+			defer db.Close()
+			done := make(chan error, 1)
+			go func() { _, err := db.ExecContext(ctx, statement); done <- err }()
+			select {
+			case <-c.seen:
+			case <-time.After(time.Second):
+				t.Fatal("actualnative frame never sent")
+			}
+			select {
+			case err := <-done:
+				if !errors.Is(err, context.Canceled) || errors.Is(err, sqldriver.ErrBadConn) {
+					t.Fatalf("uncertain result replayable: %v", err)
+				}
+			case <-time.After(time.Second):
+				c.mu.Lock()
+				for _, w := range c.wires {
+					_ = w.Close()
+				}
+				c.mu.Unlock()
+				<-done
+				t.Fatal("actual sentRPC ignored cancel")
+			}
+			if c.connects.Load() != 1 || c.executions.Load() != 1 {
+				t.Fatalf("replayed unknown%s: connects=%d sentframes=%d", statement, c.connects.Load(), c.executions.Load())
+			}
+			nextCtx, nextCancel := context.WithTimeout(context.Background(), time.Second)
+			defer nextCancel()
+			if _, err := db.ExecContext(nextCtx, "INSERT INTO replacement VALUES(2)"); err != nil {
+				t.Fatalf("future connection not replaced: %v", err)
+			}
+			if c.connects.Load() != 2 || c.executions.Load() != 1 {
+				t.Fatalf("future reconnect/replay: connections=%d old frames=%d", c.connects.Load(), c.executions.Load())
+			}
+
+		})
+	}
+}
