+func TestRPCCancelSuccessfulWireHasNoLateCallback(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	p := &Protocol{conn: a}
+	q, r := rpcCancelMessages()
+	go func() {
+		for rpcCancelFrame(b) == nil {
+			if rpcCancelResponse(b) != nil {
+				return
+			}
+		}
+	}()
+	for i := 0; i < 50; i++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		err := p.Call(ctx, q, r)
+		cancel()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := p.Call(context.Background(), q, r); err != nil {
+			t.Fatalf("old canceled context affected next RPC: %v", err)
+		}
+	}
+}
