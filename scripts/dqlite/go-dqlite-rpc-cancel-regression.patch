+type rpcLateDeadline struct {
+	context.Context
+	when time.Time
+}
+
+func (c rpcLateDeadline) Deadline() (time.Time, bool) { return c.when, true }
+
+type rpcCloseGate struct {
+	net.Conn
+	entered, resume chan struct{}
+	once            sync.Once
+	count           atomic.Int32
+	closeErr        error
+	beforeClose     bool
+}
+
+func (w *rpcCloseGate) Close() error {
+	w.count.Add(1)
+	var err error
+	if !w.beforeClose {
+		err = w.Conn.Close()
+	}
+	w.once.Do(func() {
+		if w.entered != nil {
+			close(w.entered)
+		}
+		if w.resume != nil {
+			<-w.resume
+		}
+	})
+	if w.beforeClose {
+		err = w.Conn.Close()
+	}
+	if w.closeErr != nil {
+		return w.closeErr
+	}
+	return err
+}
+
+type rpcCloseNotify struct {
+	net.Conn
+	raw   net.Conn
+	calls atomic.Int32
+}
+
+func (w *rpcCloseNotify) NetConn() net.Conn { return w.raw }
+func (w *rpcCloseNotify) Close() error {
+	w.calls.Add(1)
+	_, err := w.Conn.Write([]byte("close-notify"))
+	_ = w.Conn.Close()
+	return err
+}
