+type rpcCancelWire struct {
+	net.Conn
+	entered chan struct{}
+	once    sync.Once
+	reading bool
+	writes  atomic.Int32
+}
+
+func (w *rpcCancelWire) Read(p []byte) (int, error) {
+	if w.reading {
+		w.once.Do(func() { close(w.entered) })
+	}
+	return w.Conn.Read(p)
+}
+func (w *rpcCancelWire) Write(p []byte) (int, error) {
+	w.writes.Add(1)
+	if !w.reading {
+		w.once.Do(func() { close(w.entered) })
+	}
+	return w.Conn.Write(p)
+}
+func rpcCancelFrame(c net.Conn) error {
+	var h [8]byte
+	if _, e := io.ReadFull(c, h[:]); e != nil {
+		return e
+	}
+	_, e := io.CopyN(io.Discard, c, int64(binary.LittleEndian.Uint32(h[:]))*8)
+	return e
+}
+func rpcCancelResponse(c net.Conn) error {
+	var h [8]byte
+	h[4] = ResponseEmpty
+	_, e := c.Write(h[:])
+	return e
+}
+func rpcCancelMessages() (*Message, *Message) {
+	q, r := &Message{}, &Message{}
+	q.Init(256)
+	r.Init(256)
+	EncodeExecSQLV0(q, 0, "INSERT INTO rpc_cancel VALUES(1)", nil)
+	return q, r
+}
