+func TestRPCCancelPreCanceledAndDeadline(t *testing.T) {
+	for _, method := range []string{"Call", "More", "Interrupt"} {
+		t.Run(method, func(t *testing.T) {
+			a, b := net.Pipe()
+			defer a.Close()
+			defer b.Close()
+			w := &rpcCancelWire{Conn: a, entered: make(chan struct{})}
+			p := &Protocol{conn: w}
+			q, r := rpcCancelMessages()
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			done := make(chan error, 1)
+			go func() {
+				switch method {
+				case "Call":
+					done <- p.Call(ctx, q, r)
+				case "More":
+					done <- p.More(ctx, r)
+				case "Interrupt":
+					done <- p.Interrupt(ctx, q, r)
+				}
+			}()
+			var err error
+			select {
+			case err = <-done:
+			case <-time.After(200 * time.Millisecond):
+				_ = b.Close()
+				err = <-done
+				t.Error("pre-canceled RPC performed IO")
+			}
+			if !errors.Is(err, context.Canceled) {
+				t.Errorf("error=%v", err)
+			}
+			if method == "Call" {
+				if w.writes.Load() != 0 || p.netErr != nil {
+					t.Error("unsent canceled Call dirtied wire")
+				}
+			} else if !errors.Is(p.netErr, io.EOF) {
+				t.Error("pre-canceled stream continuation not discarded")
+			}
+		})
+	}
+	t.Run("natural-deadline", func(t *testing.T) {
+		a, b := net.Pipe()
+		defer a.Close()
+		defer b.Close()
+		p := &Protocol{conn: a}
+		q, r := rpcCancelMessages()
+		go func() { _ = rpcCancelFrame(b) }()
+		ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+		defer cancel()
+		if err := p.Call(ctx, q, r); !errors.Is(err, context.DeadlineExceeded) {
+			t.Errorf("socket deadline lost context identity: %T %v", err, err)
+		}
+	})
+}
