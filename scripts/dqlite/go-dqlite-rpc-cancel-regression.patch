+func TestRPCCancelActiveWire(t *testing.T) {
+	for _, method := range []string{"Call-read", "Call-write", "More", "Interrupt-read", "Interrupt-write"} {
+		for _, longDeadline := range []bool{false, true} {
+			name := method + map[bool]string{false: "/no-deadline", true: "/long-deadline"}[longDeadline]
+			t.Run(name, func(t *testing.T) {
+				a, b := net.Pipe()
+				defer a.Close()
+				defer b.Close()
+				reading := method != "Call-write" && method != "Interrupt-write"
+				w := &rpcCancelWire{Conn: a, entered: make(chan struct{}), reading: reading}
+				tracker := &LeaderTracker{}
+				p := &Protocol{conn: w, lt: tracker}
+				q, r := rpcCancelMessages()
+				if reading && method != "More" {
+					go func() { _ = rpcCancelFrame(b) }()
+				}
+				ctx, cancel := context.WithCancel(context.Background())
+				if longDeadline {
+					cancel()
+					ctx, cancel = context.WithTimeout(context.Background(), 10*time.Second)
+				}
+				defer cancel()
+				done := make(chan error, 1)
+				go func() {
+					switch method {
+					case "More":
+						done <- p.More(ctx, r)
+					case "Interrupt-read", "Interrupt-write":
+						done <- p.Interrupt(ctx, q, r)
+					default:
+						done <- p.Call(ctx, q, r)
+					}
+				}()
+				select {
+				case <-w.entered:
+				case <-time.After(time.Second):
+					t.Fatal("RPC never entered actual pipe IO")
+				}
+				cancel()
+				var err error
+				select {
+				case err = <-done:
+				case <-time.After(200 * time.Millisecond):
+					_ = b.Close()
+					err = <-done
+					t.Error("RPC ignored cancellation during actual wire IO")
+				}
+				if !errors.Is(err, context.Canceled) {
+					t.Errorf("current sent/stream RPC error=%T %v, want context.Canceled", err, err)
+				}
+				if p.lt != nil {
+					t.Error("canceled protocol retained donation owner")
+				}
+				_ = p.Close()
+				if tracker.TakeSharedProtocol() != nil {
+					t.Error("poisoned wire donated")
+				}
+				before := w.writes.Load()
+				next := make(chan error, 1)
+				go func() { next <- p.Call(context.Background(), q, r) }()
+				select {
+				case err = <-next:
+				case <-time.After(200 * time.Millisecond):
+					_ = a.Close()
+					err = <-next
+					t.Error("future poisoned RPC blocked")
+				}
+				if !errors.Is(err, io.EOF) || w.writes.Load() != before {
+					t.Errorf("future unsent RPC did not signal replacement without IO: err=%v writes=%d/%d", err, w.writes.Load(), before)
+				}
+			})
+		}
+	}
+}
