+func TestRPCCancelHealthyCloseStillDonates(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	wire := &rpcFirstCloseWire{Conn: a}
+	tracker := &LeaderTracker{}
+	p := &Protocol{conn: wire, lt: tracker}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if got := tracker.TakeSharedProtocol(); got != p {
+		t.Fatal("healthy protocol not donated")
+	}
+	if wire.calls.Load() != 0 {
+		t.Fatal("healthy donation physically closed protocol")
+	}
+	go func() {
+		if rpcCancelFrame(b) == nil {
+			_ = rpcCancelResponse(b)
+		}
+	}()
+	q, r := rpcCancelMessages()
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := p.Call(ctx, q, r); err != nil {
+		t.Fatalf("healthy reborrowed protocol unusable: %v", err)
+	}
+	p.Bad()
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if wire.calls.Load() != 1 {
+		t.Fatal("healthy physical close repeated")
+	}
+}
