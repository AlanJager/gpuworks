+func TestRPCCancelJoinsCallbackAndPreservesCloseError(t *testing.T) {
+	for _, ackWins := range []bool{false, true} {
+		ackWins := ackWins
+		t.Run(map[bool]string{false: "blocked-read", true: "ack-races-cancel"}[ackWins], func(t *testing.T) {
+			a, b := net.Pipe()
+			defer a.Close()
+			defer b.Close()
+			in, resume := make(chan struct{}), make(chan struct{})
+			var release sync.Once
+			unblock := func() { release.Do(func() { close(resume) }) }
+			defer unblock()
+			raw := &rpcCloseGate{Conn: a, entered: in, resume: resume, closeErr: io.EOF, beforeClose: ackWins}
+			outer := &rpcCloseNotify{Conn: raw, raw: raw}
+			p := &Protocol{conn: outer, lt: &LeaderTracker{}}
+			q, r := rpcCancelMessages()
+			seen := make(chan struct{})
+			ack := make(chan struct{})
+			acked := make(chan error, 1)
+			go func() {
+				_ = rpcCancelFrame(b)
+				close(seen)
+				if ackWins {
+					<-ack
+					acked <- rpcCancelResponse(b)
+				}
+			}()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- p.Call(ctx, q, r) }()
+			<-seen
+			cancel()
+			select {
+			case <-in:
+			case err := <-done:
+				t.Fatalf("no cancellation close: %v", err)
+			case <-time.After(time.Second):
+				t.Fatal("raw callback neverstarted")
+			}
+			closeDone := make(chan error, 1)
+			go func() { closeDone <- p.Close() }()
+			if ackWins {
+				close(ack)
+				select {
+				case err := <-acked:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(time.Second):
+					t.Fatal("ACK did not complete before raw Close")
+				}
+			}
+			if outer.calls.Load() != 0 {
+				t.Error("callback called outer close-notify")
+			}
+			select {
+			case <-done:
+				t.Fatal("owner returned before callbackjoined")
+			case <-closeDone:
+				t.Fatal("Protocol.Close returned before cancellation callback joined")
+			case <-time.After(20 * time.Millisecond):
+			}
+			unblock()
+			err := <-done
+			if closeErr := <-closeDone; !errors.Is(closeErr, io.EOF) {
+				t.Fatalf("Close lost first outcome: %v", closeErr)
+			}
+			if !errors.Is(err, context.Canceled) || !errors.Is(err, io.EOF) {
+				t.Fatalf("lost cancellation/Close error: %v", err)
+			}
+			if raw.count.Load() != 2 || outer.calls.Load() != 1 {
+				t.Errorf("expected one callback rawClose plus one synchronous wrapper cleanup, got rawClose%d times", raw.count.Load())
+			}
+			if p.lt != nil {
+				t.Fatal("interrupted ACK wire stilldonatable")
+			}
+		})
+	}
+}
