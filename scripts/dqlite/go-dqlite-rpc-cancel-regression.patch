+func TestRPCCancelCachesFirstPhysicalCloseOutcome(t *testing.T) {
+	sentinel := errors.New("first physical close reported failure")
+	for _, firstErr := range []error{nil, sentinel} {
+		t.Run(map[bool]string{true: "success", false: "failure"}[firstErr == nil], func(t *testing.T) {
+			a, b := net.Pipe()
+			defer b.Close()
+			defer a.Close()
+			wire := &rpcFirstCloseWire{Conn: a, firstErr: firstErr}
+			tracker := &LeaderTracker{}
+			p := &Protocol{conn: wire, lt: tracker}
+			q, r := rpcCancelMessages()
+			seen := make(chan struct{})
+			go func() { _ = rpcCancelFrame(b); close(seen) }()
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- p.Call(ctx, q, r) }()
+			<-seen
+			cancel()
+			var err error
+			select {
+			case err = <-done:
+			case <-time.After(200 * time.Millisecond):
+				_ = wire.Close()
+				err = <-done
+				t.Error("active cancellation did not initiate physical close")
+			}
+			if !errors.Is(err, context.Canceled) || (firstErr != nil && !errors.Is(err, firstErr)) {
+				t.Fatalf("lost original cancellation/close: %v", err)
+			}
+			for i := 0; i < 3; i++ {
+				if got := p.Close(); got != firstErr {
+					t.Errorf("Close repeated physical operation or lost first outcome: got=%v want=%v", got, firstErr)
+				}
+			}
+			if wire.calls.Load() != 1 {
+				t.Errorf("physical Close count=%d want1", wire.calls.Load())
+			}
+			if tracker.TakeSharedProtocol() != nil {
+				t.Fatal("canceled connection donated")
+			}
+		})
+	}
+}
