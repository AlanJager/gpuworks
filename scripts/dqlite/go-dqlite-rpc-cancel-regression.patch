+func TestRPCCancelDirectTLSOwnsPhysicalClose(t *testing.T) {
+	public, private, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, public, private)
+	if err != nil {
+		t.Fatal(err)
+	}
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	raw := &rpcFirstCloseWire{Conn: a}
+	client := tls.Client(raw, &tls.Config{InsecureSkipVerify: true}) // Isolated self-signed fixture.
+	server := tls.Server(b, &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: private}}, SessionTicketsDisabled: true})
+	serverDone := make(chan error, 1)
+	go func() { serverDone <- server.Handshake() }()
+	if err := client.Handshake(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-serverDone; err != nil {
+		t.Fatal(err)
+	}
+	seen := make(chan struct{})
+	go func() { _ = rpcCancelFrame(server); close(seen) }()
+	p := &Protocol{conn: client, lt: &LeaderTracker{}}
+	q, r := rpcCancelMessages()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { done <- p.Call(ctx, q, r) }()
+	<-seen
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) || errors.Is(err, net.ErrClosed) {
+			t.Errorf("TLS introduced duplicate-close failure: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("TLS cancel did not return")
+	}
+	for i := 0; i < 3; i++ {
+		if err := p.Close(); err != nil {
+			t.Errorf("TLS cleanup fabricated Close error: %v", err)
+		}
+	}
+	if raw.calls.Load() != 1 {
+		t.Errorf("TLS physical Close count=%d want1", raw.calls.Load())
+	}
