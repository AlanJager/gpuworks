+func rpcCancelTransport(conn net.Conn) (net.Conn, bool) {
+	// A discarded direct TLS connection owns no additional external cleanup.
+	// Closing it after its raw transport would close the same socket twice.
+	if conn, ok := conn.(*tls.Conn); ok {
+		return conn.NetConn(), false
+	}
+	if wrapped, ok := conn.(interface{ NetConn() net.Conn }); ok {
+		if raw := wrapped.NetConn(); raw != nil {
+			return raw, true
+		}
+	}
+	return conn, false
+}
