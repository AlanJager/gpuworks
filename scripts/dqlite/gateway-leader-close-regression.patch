+/* A failed exec allocation must not leave a request with no completion callback. */
+TEST_CASE(query, exec_allocation_failure_closes_leader, NULL)
+{
+	struct query_fixture *f = data;
+	(void)params;
+	uint64_t stmt_id;
+	PREPARE("SELECT n FROM test");
+	f->request.db_id = 0;
+	f->request.stmt_id = stmt_id;
+	ENCODE(&f->request, query);
+	struct db *db = registry__get(CLUSTER_REGISTRY(0), "test");
+	munit_assert_not_null(db);
+	munit_assert_int(db->leaders, ==, 1);
+
+	/* Request encoding and statement preparation are complete. The first
+	 * raft allocation in this request is the exec object. Fail only it. */
+	test_raft_heap_fault_config(0, 1);
+	test_raft_heap_fault_enable();
+	HANDLE_STATUS(DQLITE_REQUEST_QUERY, DQLITE_ERROR);
+	test_raft_heap_fault_config(-1, 0);
+	munit_assert_false(f->context->invoked);
+
+	/* Model the connection's error-close path without a transport fault. */
+	gateway__close(f->gateway, closeCb);
+	munit_assert_true(f->context->invoked);
+	munit_assert_null(f->gateway->req);
+	munit_assert_null(f->gateway->leader);
+	munit_assert_int(db->leaders, ==, 0);
+	return MUNIT_OK;
+}
