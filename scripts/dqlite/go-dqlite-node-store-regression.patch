+func TestYamlNodeStoreSnapshotOwnershipAndConcurrentAccess(t *testing.T) {
+	s, path, nodes := nodeStoreFixture(t)
+	want := append([]NodeInfo(nil), nodes...)
+	if err := s.Set(context.Background(), nodes); err != nil {
+		t.Fatal(err)
+	}
+	nodes[0].ID = 99
+	requireNodeStore(t, s, want)
+	got, _ := s.Get(context.Background())
+	got[0].Address = "changed"
+	requireNodeStore(t, s, want)
+	var wg sync.WaitGroup
+	errs := make(chan error, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			for n := 0; n < 20; n++ {
+				if i%2 == 0 {
+					if e := s.Set(context.Background(), want); e != nil {
+						errs <- e
+						return
+					}
+				} else {
+					v, e := s.Get(context.Background())
+					if e != nil || !reflect.DeepEqual(v, want) {
+						errs <- fmt.Errorf("bad concurrent snapshot %v %v", v, e)
+						return
+					}
+				}
+			}
+		}(i)
+	}
+	wg.Wait()
+	close(errs)
+	for e := range errs {
+		t.Error(e)
+	}
+	reopened, e := NewYamlNodeStore(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	requireNodeStore(t, reopened, want)
+}
