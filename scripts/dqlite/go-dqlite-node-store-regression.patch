+func TestYamlNodeStoreFirstSetAndUnchangedFile(t *testing.T) {
+	for _, existing := range []bool{false, true} {
+		t.Run(fmt.Sprint(existing), func(t *testing.T) {
+			s, path, nodes := nodeStoreFixture(t)
+			if existing {
+				if err := s.Set(context.Background(), nodes); err != nil {
+					t.Fatal(err)
+				}
+				prior := nodeStoreStat(t, path)
+				var err error
+				s, err = NewYamlNodeStore(path)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err := s.Set(context.Background(), nodes); err != nil {
+					t.Fatal(err)
+				}
+				if os.SameFile(prior, nodeStoreStat(t, path)) {
+					t.Fatal("first Set after startup skipped persistence")
+				}
+			} else if err := s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			before := nodeStoreStat(t, path)
+			for i := 0; i < 4; i++ {
+				if err := s.Set(context.Background(), nodes); err != nil {
+					t.Fatal(err)
+				}
+			}
+			after := nodeStoreStat(t, path)
+			if !os.SameFile(before, after) || !before.ModTime().Equal(after.ModTime()) {
+				t.Fatal("unchanged Set replaced or rewrote file")
+			}
+			requireNodeStore(t, s, nodes)
+		})
+	}
+}
