+func TestYamlNodeStoreFailedWriteDoesNotPublishOrPoisonRetry(t *testing.T) {
+	for _, failure := range []string{"rename", "create"} {
+		t.Run(failure, func(t *testing.T) {
+			s, path, nodes := nodeStoreFixture(t)
+			if err := s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			saved := path + ".saved"
+			if err := os.Rename(path, saved); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Mkdir(path, 0700); err != nil {
+				t.Fatal(err)
+			}
+			if failure == "create" {
+				s.path = filepath.Join(path, "absent", "cluster.yaml")
+			}
+			next := append([]NodeInfo(nil), nodes...)
+			next[0].ID = 7
+			if err := s.Set(context.Background(), next); err == nil {
+				t.Fatal("write to invalid destination succeeded")
+			}
+			requireNodeStore(t, s, nodes)
+			s.path = path
+			if err := os.Remove(path); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Rename(saved, path); err != nil {
+				t.Fatal(err)
+			}
+			before := nodeStoreStat(t, path)
+			// Even the previous value is written after a failed operation, not falsely cached.
+			if err := s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			if os.SameFile(before, nodeStoreStat(t, path)) {
+				t.Fatal("failed write poisoned successful-write cache")
+			}
+			if err := s.Set(context.Background(), next); err != nil {
+				t.Fatal(err)
+			}
+			requireNodeStore(t, s, next)
+			files, err := filepath.Glob(filepath.Join(filepath.Dir(path), ".cluster.yaml*"))
+			if err != nil || len(files) != 0 {
+				t.Fatalf("temporary files leaked: %v %v", files, err)
+			}
+		})
+	}
+}
