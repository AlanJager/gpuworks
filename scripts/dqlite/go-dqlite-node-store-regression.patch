+func TestYamlNodeStoreRepairsCurrentFile(t *testing.T) {
+	for _, damage := range []string{"missing", "bytes", "truncated", "mode", "symlink", "hardlink", "same-bytes-replacement", "same-inode-identical", "same-inode-restored-mtime", "fifo", "replacement"} {
+		t.Run(damage, func(t *testing.T) {
+			s, path, nodes := nodeStoreFixture(t)
+			if err := s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			expected, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			target := path + ".target"
+			switch damage {
+			case "missing":
+				err = os.Remove(path)
+			case "bytes":
+				err = os.WriteFile(path, []byte("malformed: ["), 0600)
+			case "truncated":
+				err = os.Truncate(path, 0)
+			case "mode":
+				err = os.Chmod(path, 0644)
+			case "symlink":
+				if err = os.Rename(path, target); err == nil {
+					err = os.Symlink(target, path)
+				}
+			case "same-inode-identical", "same-inode-restored-mtime":
+				prior := nodeStoreStat(t, path)
+				// Ensure observable ctime advancement independently of mtime restoration.
+				time.Sleep(2 * time.Millisecond)
+				err = os.WriteFile(path, expected, 0600)
+				if err == nil && damage == "same-inode-restored-mtime" {
+					err = os.Chtimes(path, prior.ModTime(), prior.ModTime())
+				}
+			case "fifo":
+				if err = os.Remove(path); err == nil {
+					err = syscall.Mkfifo(path, 0600)
+				}
+			case "hardlink":
+				err = os.Link(path, target)
+			case "same-bytes-replacement":
+				if err = os.WriteFile(target, expected, 0600); err == nil {
+					err = os.Rename(target, path)
+				}
+			case "replacement":
+				if err = os.WriteFile(target, []byte("different"), 0600); err == nil {
+					err = os.Rename(target, path)
+				}
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			damaged, _ := os.Lstat(path)
+			if err = s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			actual, err := os.ReadFile(path)
+			if err != nil || string(actual) != string(expected) {
+				t.Fatalf("repair: %q %v", actual, err)
+			}
+			stat, err := os.Lstat(path)
+			if err != nil || !stat.Mode().IsRegular() || stat.Mode().Perm() != 0600 {
+				t.Fatalf("repair metadata: %v %v", stat, err)
+			}
+			if damaged != nil && os.SameFile(damaged, stat) {
+				t.Fatal("damaged/replaced file was not replaced")
+			}
+			if damage == "symlink" || damage == "hardlink" {
+				b, e := os.ReadFile(target)
+				if e != nil || string(b) != string(expected) {
+					t.Fatalf("symlink target modified: %q %v", b, e)
+				}
+			}
+		})
+	}
+}
