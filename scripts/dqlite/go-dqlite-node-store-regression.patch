+// External strace checks actual fsync/rename counts; a separate injected fsync EIO
+// verifies that a failed syscall cannot be converted into a cached success.
+func TestYamlNodeStorePersistenceSyscallProbe(t *testing.T) {
+	mode := os.Getenv("GPUWORKS_NODESTORE_PROBE")
+	if mode == "" {
+		return
+	}
+	s, path, nodes := nodeStoreFixture(t)
+	if mode == "startup" {
+		initial := []byte("- ID: 1\n  Address: 127.0.0.1:9001\n  Role: 0\n- ID: 2\n  Address: 127.0.0.1:9002\n  Role: 1\n")
+		if e := os.WriteFile(path, initial, 0600); e != nil {
+			t.Fatal(e)
+		}
+		var e error
+		s, e = NewYamlNodeStore(path)
+		if e != nil {
+			t.Fatal(e)
+		}
+	}
+	err := s.Set(context.Background(), nodes)
+	if mode == "sync-error" {
+		if err == nil {
+			t.Fatal("expected injected real fsync failure")
+		}
+		got, _ := s.Get(context.Background())
+		if len(got) != 0 {
+			t.Fatal("failed fsync published memory")
+		}
+	} else if err != nil {
+		t.Fatal(err)
+	}
+	if mode == "changed" {
+		nodes[0].Role = NodeRole(2)
+	}
+	if mode == "repair" {
+		if e := os.Truncate(path, 0); e != nil {
+			t.Fatal(e)
+		}
+	}
+	if err = s.Set(context.Background(), nodes); err != nil {
+		t.Fatal(err)
+	}
+	requireNodeStore(t, s, nodes)
+	reopened, e := NewYamlNodeStore(path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	requireNodeStore(t, reopened, nodes)
+}
