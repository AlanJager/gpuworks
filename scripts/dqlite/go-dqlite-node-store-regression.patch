+func TestYamlNodeStoreAllFieldsAndOrderPersist(t *testing.T) {
+	for _, field := range []string{"id", "address", "role", "order", "append", "remove"} {
+		t.Run(field, func(t *testing.T) {
+			s, path, nodes := nodeStoreFixture(t)
+			if err := s.Set(context.Background(), nodes); err != nil {
+				t.Fatal(err)
+			}
+			before := nodeStoreStat(t, path)
+			next := append([]NodeInfo(nil), nodes...)
+			switch field {
+			case "id":
+				next[0].ID = 9
+			case "address":
+				next[0].Address = "127.0.0.1:9009"
+			case "role":
+				next[0].Role = NodeRole(2)
+			case "order":
+				next[0], next[1] = next[1], next[0]
+			case "append":
+				next = append(next, NodeInfo{ID: 3, Address: "127.0.0.1:9003", Role: NodeRole(2)})
+			case "remove":
+				next = next[:1]
+			}
+			if err := s.Set(context.Background(), next); err != nil {
+				t.Fatal(err)
+			}
+			if os.SameFile(before, nodeStoreStat(t, path)) {
+				t.Fatal("changed snapshot was not persisted")
+			}
+			reopened, err := NewYamlNodeStore(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			requireNodeStore(t, reopened, next)
+			if err := s.Set(context.Background(), nil); err != nil {
+				t.Fatal(err)
+			}
+			got, err := s.Get(context.Background())
+			if err != nil || len(got) != 0 {
+				t.Fatalf("empty Set: %v %v", got, err)
+			}
+			reopened, err = NewYamlNodeStore(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err = reopened.Get(context.Background())
+			if err != nil || len(got) != 0 {
+				t.Fatalf("empty persisted: %v %v", got, err)
+			}
+		})
+	}
+}
