+func nodeStoreFixture(t *testing.T) (*YamlNodeStore, string, []NodeInfo) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "cluster.yaml")
+	s, err := NewYamlNodeStore(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return s, path, []NodeInfo{{ID: 1, Address: "127.0.0.1:9001", Role: NodeRole(0)}, {ID: 2, Address: "127.0.0.1:9002", Role: NodeRole(1)}}
+}
+
+func nodeStoreStat(t *testing.T, path string) os.FileInfo {
+	t.Helper()
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return info
+}
+
+func requireNodeStore(t *testing.T, s *YamlNodeStore, want []NodeInfo) {
+	t.Helper()
+	got, err := s.Get(context.Background())
+	if err != nil || !reflect.DeepEqual(got, want) {
+		t.Fatalf("Get=%v,%v want=%v", got, err, want)
+	}
+}
