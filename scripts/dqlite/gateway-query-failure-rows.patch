+/* A failed query step leaves the rows it already encoded in the response
+ * buffer. A failure sent after them is read by the client as a failure whose
+ * code is the column count and whose message is the first column name, so the
+ * real error is lost. Return the buffer to the start of the response body. */
+static void discard_encoded_rows(struct handle *req)
+{
+	void *cursor;
+	buffer__reset(req->buffer);
+	cursor = buffer__advance(req->buffer, req->response_offset);
+	dqlite_assert(cursor != NULL);
+}
