{
  "materialize": {
    "quick": {
      "performance_mode": "balanced",
      "enable_cache_report": true,
      "enable_request_metrics": true,
      "dtype": "auto",
      "kv_cache_dtype": "auto",
      "gpu_memory_utilization": 0.9,
      "kv_offloading_size": 8
    },
    "role_quick": {
      "performance_mode": "balanced",
      "enable_cache_report": true,
      "enable_request_metrics": true,
      "dtype": "auto",
      "kv_cache_dtype": "auto",
      "gpu_memory_utilization": 0.9,
      "kv_offloading_size": 8
    }
  },
  "launch": {
    "error": {
      "code": "KV_OFFLOAD_BACKEND_UNSUPPORTED_ON_TARGET",
      "params": {
        "backend": "native",
        "vendor": "Ascend"
      },
      "text": "KV offload backend native does not run on Ascend"
    },
    "shm_bytes": 0,
    "requested_features": {
      "command_known": true,
      "prefill_decode_disaggregation": true
    }
  },
  "export": {
    "args": [
      "--enable-prompt-tokens-details",
      "--enable-per-request-metrics",
      "--gpu-memory-utilization",
      "0.9",
      "--kv-offloading-size",
      "8",
      "--kv-offloading-backend",
      "native"
    ]
  }
}
