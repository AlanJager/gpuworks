{
  "materialize": {
    "quick": {
      "performance_mode": "balanced",
      "enable_cache_report": true,
      "enable_request_metrics": true,
      "dtype": "auto",
      "kv_cache_dtype": "auto",
      "gpu_memory_utilization": 0.9,
      "kv_offloading_size": 16,
      "kv_disk_offload": true,
      "kv_offload_read_threads": 16,
      "kv_offload_write_threads": 16,
      "kv_offload_backend": "lmcache",
      "shared_kv_dir": "/kv-cache"
    },
    "validation": {
      "code": "KV_OFFLOAD_BACKEND_CONFLICTS_NATIVE_TIER",
      "params": {
        "backend": "lmcache",
        "key": "kv_offloading_size"
      },
      "text": "KV offload backend lmcache replaces kv_offloading_size"
    }
  },
  "launch": {
    "error": {
      "code": "KV_OFFLOAD_BACKEND_CONFLICTS_NATIVE_TIER",
      "params": {
        "backend": "lmcache",
        "key": "kv_offloading_size"
      },
      "text": "KV offload backend lmcache replaces kv_offloading_size"
    },
    "shm_bytes": 0
  },
  "export": {
    "args": [
      "--enable-prompt-tokens-details",
      "--enable-per-request-metrics",
      "--gpu-memory-utilization",
      "0.9",
      "--kv-transfer-config",
      "{\"kv_connector\":\"LMCacheMPConnector\",\"kv_connector_extra_config\":{\"lmcache.mp.host\":\"tcp://localhost\",\"lmcache.mp.mp_transfer_mode\":\"lmcache_driven\",\"lmcache.mp.port\":5555},\"kv_connector_module_path\":\"lmcache.integration.vllm.lmcache_mp_connector\",\"kv_role\":\"kv_both\"}"
    ]
  }
}
