[
  "vllm",
  "serve",
  "/model",
  "--host",
  "0.0.0.0",
  "--port",
  "30000",
  "--tensor-parallel-size",
  "1",
  "--enable-prompt-tokens-details",
  "--enable-per-request-metrics",
  "--gpu-memory-utilization",
  "0.9",
  "--kv-transfer-config",
  "{\"kv_connector\":\"OffloadingConnector\",\"kv_connector_extra_config\":{\"cpu_bytes_to_use\":17179869184,\"secondary_tiers\":[{\"n_read_threads\":8,\"n_write_threads\":4,\"root_dir\":\"/kv-cache\",\"type\":\"fs\"}],\"spec_name\":\"TieringOffloadingSpec\"},\"kv_role\":\"kv_both\"}",
  "--speculative-config",
  "{\"method\":\"eagle3\",\"model\":\"org/draft\",\"num_speculative_tokens\":3}",
  "-O3",
  "--served-model-name",
  "template-name",
  "--enable-metrics"
]
