[
  "python",
  "-m",
  "sglang.launch_server",
  "--model-path",
  "/model",
  "--tp-size",
  "1",
  "--host",
  "0.0.0.0",
  "--port",
  "30000",
  "--served-model-name",
  "qwen3-8b",
  "--log-level",
  "notset",
  "--enable-metrics",
  "--context-length",
  "1",
  "--mem-fraction-static",
  "0.98",
  "--chunked-prefill-size",
  "1",
  "--max-running-requests",
  "1",
  "--kv-cache-dtype",
  "fp4_mx_block16",
  "--dtype",
  "float32",
  "--quantization",
  "example",
  "--enable-cache-report",
  "--disable-cuda-graph",
  "--speculative-algorithm",
  "STANDALONE",
  "--speculative-draft-model-path",
  "example",
  "--speculative-num-steps",
  "1",
  "--speculative-eagle-topk",
  "1",
  "--speculative-num-draft-tokens",
  "1",
  "--reasoning-parser",
  "example",
  "--tool-call-parser",
  "example",
  "--enable-auto-tool-choice",
  "--trust-remote-code",
  "--dp-size",
  "1",
  "--enable-lora"
]
