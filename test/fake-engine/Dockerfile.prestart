# The base image must be declared before the first FROM: an ARG declared
# inside a build stage (after a FROM) is scoped to that stage only and is
# invisible to a later FROM, which silently resolves to a blank image name
# ("base name should not be blank") instead of falling back to this default.
ARG GPUWORKS_L3_SHELL_BASE_IMAGE=busybox:1.36
FROM gpuworks/fake-engine:test AS fixture
FROM ${GPUWORKS_L3_SHELL_BASE_IMAGE}
COPY --from=fixture /usr/local/bin/fake-engine /usr/local/bin/fake-engine
ENTRYPOINT ["/usr/local/bin/fake-engine"]
